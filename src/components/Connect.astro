---
import {createElement} from 'react';
import {renderToStaticMarkup} from 'react-dom/server';
import {FaGithub,FaLinkedin,FaEnvelope,FaFileAlt} from 'react-icons/fa';
import {profile as p} from '../data/profile';
const contacts=[
 {name:'Work GitHub',url:p.links[1][1],icon:FaGithub,handle:'@omkarmohanta09',description:'Deployment automation, release recovery, and tools for infrastructure teams.',meta:'VegaStack · Work contributions',kind:'github'},
 {name:'Personal GitHub',url:p.links[2][1],icon:FaGithub,handle:'@omkarmohanta50',description:'Cloud infrastructure, containers, automation, and application development.',meta:'Personal GitHub profile',kind:'github'},
 {name:'LinkedIn',url:p.links[0][1],icon:FaLinkedin,handle:'DevOps Engineer',description:'VegaStack (PeerXP)',meta:'Cloud infrastructure · Release engineering · AI agents',kind:'linkedin'},
 {name:'Mail',url:'mailto:'+p.email,icon:FaEnvelope,handle:p.email,description:'Get in touch with Omkar.',meta:'',kind:'mail'},
 {name:'Résumé',url:'/resume.pdf',icon:FaFileAlt,handle:'DevOps Engineer',description:'Experience, education, and technical skills.',meta:'PDF résumé',kind:'resume'}
];
---
<div class="links">
{contacts.map((c,i)=><div class="contact-wrap"><a class="contact-pill" href={c.url} aria-describedby={'preview-'+i}><Fragment set:html={renderToStaticMarkup(createElement(c.icon,{'aria-hidden':true,size:14}))}/>{c.name}</a>
<div class={'profile-preview '+c.kind} role="tooltip" id={'preview-'+i}>
<div class="preview-banner"></div><div class="preview-body"><div class="preview-heading"><span class="preview-avatar" aria-hidden="true">OM</span><div><strong>Omkar Mohanta</strong><small>{c.handle}</small></div></div><p>{c.description}</p><small>{c.meta}</small></div></div></div>)}
</div>
