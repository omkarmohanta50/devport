---
import Shell from '../layouts/Shell.astro';
import { FaGithub } from 'react-icons/fa';
import { createElement } from 'react';
import { renderToStaticMarkup } from 'react-dom/server';
const projects = [
  {
    title: 'Secure Kubernetes Application Deployment', date: '01.2026', datetime: '2026-01',
    description: 'A secure Python API deployed with Docker, Kubernetes, Terraform, and Helm. Non-root containers serve on port 80 using Linux capabilities, with security hardening, resource quotas, and automated deployment and validation through shell scripts and GitHub Actions.',
    stack: ['Python', 'Docker', 'Kubernetes', 'Terraform', 'Helm', 'GitHub Actions'],
    url: 'https://github.com/omkarmohanta50/Devops_Challenge'
  },
  {
    title: 'Automated Build & Deployment Pipeline', date: '10.2025', datetime: '2025-10',
    description: 'A CI/CD pipeline for a Java web application, compiled with Maven and deployed to Dockerized Tomcat through Jenkins. Jenkins runs on AWS EC2 with GitHub integration, SCM polling, automated artifact delivery, and Docker image builds.',
    stack: ['AWS EC2', 'Jenkins', 'Docker', 'Java', 'Maven', 'Tomcat'],
    url: 'https://github.com/omkarmohanta50/Java-webapp-pipeline'
  }
];
---
<Shell title="Projects">
  <div class="gallery-intro"><h1>Projects</h1></div>
  <p class="collection-description">Selected work in container security, infrastructure as code, and automated software delivery.</p>
  <div class="projects-grid">
    {projects.map(project=><article class="project-cell"><div class="project-card">
      <div class="project-heading"><h2>{project.title}</h2><time datetime={project.datetime}>{project.date}</time></div>
      <p>{project.description}</p>
      <ul class="project-stack" aria-label="Technologies">{project.stack.map(tech=><li>{tech}</li>)}</ul>
      <a class="project-source" href={project.url} target="_blank" rel="noopener noreferrer">GitHub <Fragment set:html={renderToStaticMarkup(createElement(FaGithub, {size:14, 'aria-hidden':true}))}/></a>
    </div></article>)}
  </div>
</Shell>
<style>
.projects-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px;min-height:55vh;align-content:start}
.project-cell{position:relative;padding:8px;border-block:1px solid var(--rule)}
.project-cell:first-child{border-right:1px solid var(--rule)}.project-cell:last-child{border-left:1px solid var(--rule)}
.project-card{display:flex;flex-direction:column;gap:4px;padding:8px;height:100%;overflow:hidden;border:1px dashed var(--rule);border-radius:12px;background:color-mix(in srgb,var(--bg) 50%,transparent);transition:background-color .3s}
.project-card:hover{background:color-mix(in srgb,var(--panel) 50%,var(--bg))}
.project-heading{display:flex;justify-content:space-between;align-items:start;gap:8px;padding:0 4px}
.project-heading h2{margin:0;padding:0;border:0;letter-spacing:normal;font:600 16px/22px "Geist Variable",sans-serif}
.project-heading h2::after{display:none}.project-heading time{flex-shrink:0;color:var(--muted);font:400 14px/20px "Geist Variable",sans-serif}
.project-card>p{padding:0 4px;margin:0;color:var(--muted);font:400 14px/20px "Geist Variable",sans-serif}
.project-stack{display:flex;flex-wrap:wrap;gap:8px;margin:0;padding:0 4px;list-style:none}
.project-stack li{border:1px solid var(--rule);border-radius:3px;padding:2px 6px;background:var(--bg);color:var(--muted);font:400 12px/16px "Geist Variable",sans-serif}
.project-source{display:flex;align-items:center;justify-content:center;gap:8px;margin-top:auto;padding-top:8px;border-top:1px dashed var(--rule);color:var(--muted);font:400 14px/20px "Geist Variable",sans-serif}
.project-source:hover{color:var(--fg);text-decoration:none}
@media(max-width:639px){.projects-grid{grid-template-columns:1fr}.project-cell:first-child,.project-cell:last-child{border-inline:0}}
@media(prefers-reduced-motion:reduce){.project-card{transition:none}}
</style>
