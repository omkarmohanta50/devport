---
import Shell from '../layouts/Shell.astro';
import Connect from '../components/Connect.astro';

import Activity from '../components/Activity.astro';
import { Eye, Contrast, Terminal, BriefcaseBusiness, GraduationCap, BookOpen, Award, ChevronDown } from '@lucide/astro';
import {profile as p} from '../data/profile';
---
<Shell>
<div class="banner" aria-hidden="true"></div>
<section class="identity">
<button class="avatar" id="avatar" aria-pressed="false" aria-label="Toggle avatar"><span class="alternate"><Terminal size={52}/></span><svg viewBox="0 0 64 64"><rect width="64" height="64" fill="#e6e6de"/><text x="32" y="43" text-anchor="middle" font-family="PixelGrid" font-size="33" fill="#252927">OM</text></svg></button>
<span class="views"><Eye size={14}/><span id="count" title="Unique browsers" aria-label="Unique browsers">—</span></span>
<div class="identity-copy"><button class="profile-symbol" id="avatar-switch" aria-label="Toggle avatar" title="Toggle avatar" aria-pressed="false"><Contrast size={14}/></button><h1>{p.name}</h1><p class="rotator"><span id="role">{p.role}</span></p><small>VegaStack (PeerXP)</small></div></section>
<section><h2>About</h2><ul class="about">
<li>I'm a DevOps engineer at VegaStack. I work across cloud infrastructure, deployment automation, and the tools people use to operate services.</li>
<li>I provision infrastructure with Terraform and CloudFormation, work with AWS services including EC2, S3, IAM, VPC, Lambda, DynamoDB, and CloudWatch, and run containerized applications with Docker and Kubernetes.</li>
<li>I build release workflows with Jenkins, GitHub Actions, and AWS CodePipeline. I also work on recovery from interrupted deployments, container image delivery, and service health reporting.</li>
<li>I build AI agents and work hands-on with Vercel Eve. Agent development is part of my work alongside infrastructure and release engineering.</li>
<li>I use Python and shell scripts to automate operational tasks, and work with Git and Linux throughout the development and deployment process.</li>
<li>My application development background includes Java, Kotlin, and Firebase. It helps me understand the software on both sides of a deployment.</li>
</ul></section><section id="connect"><h2>Connect</h2><Connect/></section>
<section><h2>GitHub Activity</h2><Activity/><a class="activity-link" href="/activity/">View activity</a></section>
<section id="experience"><h2>Experience</h2><div class="entry"><span class="company"><BriefcaseBusiness size={20}/></span><div><h3>VegaStack (PeerXP)</h3><details><summary>DevOps</summary><p>{p.work}</p></details><div class="chips">{['AWS','Terraform','Kubernetes','Docker','GitHub Actions'].map(t=><span>{t}</span>)}</div></div></div></section>
<section id="expertise"><h2>Expertise</h2>{p.expertise.map(([title,desc,tech])=><article class="entry-detail"><h3>{title}</h3><p>{desc}</p><small>{tech}</small></article>)}</section>
<section id="education"><h2>Education</h2>
{[
  [GraduationCap,'Biju Patnaik University of Technology','B.Tech · Computer Science and Engineering','2021–2025','Odisha, India · CGPA 7.9/10'],
  [BookOpen,'College of Basic Science & Humanities','Intermediate Science','2019–2021','Odisha, India · 89%']
].map(row=>{const [Icon,title,degree,dates,detail]=row as [typeof GraduationCap,string,string,string,string];return <details class="school"><summary><span class="company"><Icon size={22}/></span><span><strong>{title}</strong><small>{degree}</small></span><time>{dates}</time><ChevronDown size={16} class="chevron"/></summary><p>{detail}</p></details>})}</section>
<section id="credentials"><h2>Credentials</h2>{p.background.slice(2).map(([title,,issuer,date])=><div class="entry"><Award size={18}/><div><h3>{title}</h3><p>{issuer}</p></div><small>{date}</small></div>)}</section><script>
const avatar=document.querySelector<HTMLButtonElement>('#avatar')!;
avatar.setAttribute('aria-pressed',String(localStorage.getItem('avatar')==='alternate'));
const switcher=document.querySelector<HTMLButtonElement>('#avatar-switch')!;
switcher.setAttribute('aria-pressed',avatar.getAttribute('aria-pressed')!);
switcher.onclick=()=>avatar.click();
avatar.onclick=()=>{const active=avatar.getAttribute('aria-pressed')!=='true';avatar.setAttribute('aria-pressed',String(active));localStorage.setItem('avatar',active?'alternate':'initials');switcher.setAttribute('aria-pressed',String(active))};
const role=document.querySelector<HTMLElement>('#role')!;
const titles=['DevOps Engineer','Building AI agents','Platform engineering'];
let current=0;
if(!matchMedia('(prefers-reduced-motion: reduce)').matches)setInterval(()=>{
 if(document.hidden)return;
 current=(current+1)%titles.length;
 role.textContent=titles[current];
 role.animate([{transform:'translateY(80%)',opacity:0},{transform:'translateY(0)',opacity:1}],{duration:300,easing:'ease-out'});
},3200);
async function showViews(){
 const count=document.querySelector<HTMLElement>('#count')!;
 try{
  const response=await fetch('/api/views',{method:'POST'});
  if(!response.ok)throw new Error();
  count.textContent=Number((await response.json()).views).toLocaleString();
 }catch{
  count.textContent='—';
  count.title='Visitor count unavailable';
 }
}
showViews();
async function refreshCount(){
 try{
  const response=await fetch('/api/views',{cache:'no-store'});
  if(response.ok)document.querySelector('#count')!.textContent=Number((await response.json()).views).toLocaleString();
 }catch{}
}
window.addEventListener('focus',refreshCount);
setInterval(()=>{if(!document.hidden)refreshCount()},15000);
</script></Shell>




