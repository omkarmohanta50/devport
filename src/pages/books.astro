---
import Shell from '../layouts/Shell.astro';
import Cover from '../components/Cover.astro';
import {BookOpen} from '@lucide/astro';
const books=[
 ['The Monk Who Sold His Ferrari','Robin Sharma','monk'],
 ['Who Will Cry When You Die?','Robin Sharma','cry'],
 ['The Power of Your Subconscious Mind','Joseph Murphy','mind']
];
---
<Shell title="Books"><div class="gallery-intro"><h1>Books</h1></div><section class="media-section"><h2><BookOpen size={18}/>Books</h2><div class="cover-grid">{books.map(([title,author,image])=><Cover title={title} subtitle={author} image={'/images/'+image+'.jpg'}/>)}</div></section></Shell>
