---
import Shell from '../layouts/Shell.astro';
const books=[
 ['The Monk Who Sold His Ferrari','Robin Sharma'],
 ['Who Will Cry When You Die?','Robin Sharma'],
 ['The Power of Your Subconscious Mind','Joseph Murphy']
];
---
<Shell title="Books"><section class="collection"><h2>Books</h2><div class="book-list">{books.map(([title,author],i)=><article class="book-row"><div class={'book-spine book-'+i} aria-hidden="true"><span>{title}</span></div><div><h3>{title}</h3><p>{author}</p></div></article>)}</div></section></Shell>
